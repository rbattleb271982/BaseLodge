<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) splash screen override.
    Theme.SplashScreen on API 31+ triggers the OS-level SplashScreen API.
    windowSplashScreenBackground sets the cream fill shown during that brief
    OS-controlled moment before the Capacitor splash drawable takes over.
    No other theme properties are changed.
-->
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
    </style>
</resources>
